{
  "version": 2,
  "public": false,
  "buildCommand": "cp dashboard.html index.html && cp login.html login-page.html",
  "outputDirectory": "./",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://clinic-management-system-3gev.onrender.com/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/dashboard.html",
      "permanent": false
    }
  ]
}
