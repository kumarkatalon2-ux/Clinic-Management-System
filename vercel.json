{
  "version": 2,
  "public": false,
  "buildCommand": "echo 'Static site'",
  "outputDirectory": "src/frontend/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://clinic-management-system-3gev.onrender.com/api/$1"
    },
    {
      "source": "/(.+)",
      "destination": "/dashboard.html"
    },
    {
      "source": "/",
      "destination": "/dashboard.html"
    }
  ]
}
