{
  "version": 2,
  "public": false,
  "buildCommand": "echo 'Static HTML site'",
  "outputDirectory": "./",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://clinic-management-system-3gev.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/dashboard.html"
    }
  ]
}
