{
  "version": 2,
  "public": false,
  "buildCommand": "echo 'Static HTML'",
  "outputDirectory": ".",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://clinic-management-system-3gev.onrender.com/api/:path*"
    }
  ],
  "routes": [
    {
      "src": "^/(?!api).*",
      "dest": "/dashboard.html",
      "methods": ["GET"]
    }
  ]
}
